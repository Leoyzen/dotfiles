{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "oh-my-openagent@latest",
    "superpowers@git+https://github.com/obra/superpowers.git",
    // "file:///Users/yuchen.liu/.config/opencode/node_modules/oh-my-openagent/dist/index.js"
  ],
  "autoupdate": true,
  "model": "wolf-ai/ack-dev",
  "mcp": {
    "mcp-router": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mcp_router/cli@latest",
        "connect"
      ],
      "environment": {
        "MCPR_TOKEN": "{env:MCPR_TOKEN}",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
  },
  "enabled_providers": [
    "wolf-ai",
    "deepseek"
    // "openai"
  ],
  "tools": {
    "write": true,
    "bash": true,
    "read": true,
    "edit": true,
    "glob": true,
    "grep": true,
  },
  "agent": {
    "compaction": {
      "model": "wolf-ai/ack-dev",
      "variant": "medium",
    },
    "build": {
      "mode": "primary",
      "model": "wolf-ai/deepseek-v4-flash",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
      },
    },
    "plan": {
      "mode": "primary",
      "model": "wolf-ai/ack-dev",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
      },
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "wolf-ai/ack-dev",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git rm *": "ask",
      "git checkout *": "allow",
      "git restore *": "ask",
      "rm *": "allow",
    },
    "edit": {
      "*": "allow",
      "*.md": "allow",
    },
    "webfetch": "allow",
    "skill": "allow",
  },
  "provider": {
    "wolf-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wolf AI",
      "options": {
        "baseURL": "http://api.ai.rootcloud.info/v1",
        "litellmProxy": true,
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash",
          "id": "svc/deepseek-v4-flash",
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "options": {
            "thinking": true
          },
          "limit": {
            // "context": 202752,
            "context": 1048576,
            "output": 65535,
          },
          "modalities": {
            "input": [
              "text",
              // "image"
            ],
            "output": [
              "text"
            ],
          },
        },
        "k2p5": {
          "name": "Kimi K2.5",
          "id": "svc/kimi-k2.5-coder",
          "reasoning": true,
          "attachment": true,
          "limit": {
            // "context": 262144,
            "context": 202752,
            "output": 32768,
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ],
          },
          "interleaved": {
            "field": "reasoning_content",
          },
        },
        "ack-dev": {
          "name": "Ack Dev",
          "id": "svc/kimi-k2",
          "reasoning": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning_content",
          },
          "limit": {
            // "context": 252144,
            // "context": 262144,
            "context": 512000,
            // "context": 524288,
            // "context": 202752,
            "output": 16384,
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "video"
            ],
            "output": [
              "text"
            ],
          },
        },
        "qwen35": {
          "name": "Qwen 3.5",
          "id": "svc/qwen35",
          "reasoning": false,
          "attachment": false,
          "limit": {
            "context": 262144,
            "output": 32768,
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
        },
        "claude-sonnet": {
          "id": "openrouter/anthropic/claude-sonnet-4.6",
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 64000,
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ],
          },
        },
      },
    },
  },
  "lsp": {
    "marksman-lsp": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".mdc"
      ],
    },
  },
}