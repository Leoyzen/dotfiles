{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "oh-my-opencode-slim@latest",
    // "/Users/yuchen.liu/.config/herdr/plugins/github/gavintomlins.herdr-oh-my-agent-d4df23d2318b/packages/herdr-subagent-panes",
    // "superpowers@git+https://github.com/obra/superpowers.git",
    "@openviking/opencode-plugin",
  ],
  "autoupdate": true,
  "snapshot": false,
  "model": "alibaba-cn/deepseek-v4.1-flash",
  "mcp": {
    "mcp-router": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mcp_router/cli@latest",
        "connect"
      ],
      "environment": {
        "MCPR_TOKEN": "{env:MCPR_TOKEN}",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
  },
  "enabled_providers": [
    "alibaba-cn",
    "wolf-ack",
    "deepseek",
    "openai"
  ],
  "tools": {
    "write": true,
    "bash": true,
    "read": true,
    "edit": true,
    "glob": true,
    "grep": true,
  },
  "agent": {
    "compaction": {
      "model": "alibaba-cn/deepseek-v4.1-flash",
      "variant": "high",
    },
    "build": {
      "mode": "primary",
      "model": "alibaba-cn/deepseek-v4.1-flash",
      // NOTE: do not add a deprecated `tools` block here. `tools.bash: true`
      // compiles to a trailing `bash: allow *` permission rule that overrides
      // the global bash denies below (opencode evaluates the LAST match).
    },
    "plan": {
      "mode": "primary",
      "model": "alibaba-cn/deepseek-v4.1-flash",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
      },
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "alibaba-cn/deepseek-v4.1-flash",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
  },
  "permission": {
    // Default posture: approve everything so agents never stall on an approval
    // prompt. Only catastrophic / irreversible commands are hard-denied below
    // ("deny" fails fast and never waits for input, so nothing hangs).
    //
    // Paths outside the worktree (e.g. /tmp, ~/.config, ~/.cache, sibling
    // repos) were the single biggest source of prompts — allow them by default.
    "external_directory": {
      "*": "allow",
    },
    // Reading defaults to allow. Secret files (dotenv + direnv) require an
    // explicit approval instead of being auto-approved — a rare, deliberate
    // confirmation. Committed templates stay allowed.
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.envrc": "ask",
      "*.envrc.*": "ask",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.envrc.example": "allow",
    },
    // Override the built-in ask when the same tool call repeats (loop guard).
    "doom_loop": "allow",
    "bash": {
      "*": "allow",
      "git checkout *": "allow",
      "rm *": "allow",
      // Root-scan guard: block find/ls/du/tree/fd against the filesystem root.
      // opencode matches the WHOLE command-node text, so we enumerate the
      // wrapper forms that actually occur (sudo/env/nohup/... , flags, /usr/bin/
      // paths, double spaces). Patterns are ordered after "*": "allow" because
      // the LAST matching rule wins.
      "find /": "deny",
      "find / *": "deny",
      "find  / *": "deny",
      "find -* / *": "deny",
      "sudo find / *": "deny",
      "nohup find / *": "deny",
      "time find / *": "deny",
      "nice find / *": "deny",
      "command find / *": "deny",
      "env * find / *": "deny",
      "*=* find / *": "deny",
      "*/find / *": "deny",
      "ls /": "deny",
      "ls / *": "deny",
      "ls -* / *": "deny",
      "du /": "deny",
      "du / *": "deny",
      "du -* / *": "deny",
      "tree /": "deny",
      "tree / *": "deny",
      "tree -* / *": "deny",
      "fd /": "deny",
      "fd / *": "deny",
      "fd -* / *": "deny",

      // ── High-risk guards: hard deny (ordered last so they win). ──
      // "deny" fails immediately instead of prompting, so it never blocks.
      // Filesystem wipes of root, home, or top-level system dirs. (NB: the
      // glob "*" spans "/", so each rule names an explicit target instead of a
      // blanket "rm -rf /*" — otherwise safe calls like `rm -rf /tmp/x` break.)
      "rm -* /": "deny",
      "rm -* ~": "deny",
      "rm -* $HOME": "deny",
      "rm -* /etc*": "deny",
      "rm -* /usr*": "deny",
      "rm -* /var*": "deny",
      "rm -* /bin*": "deny",
      "rm -* /sbin*": "deny",
      "rm -* /lib*": "deny",
      "rm -* /boot*": "deny",
      "rm -* /opt*": "deny",
      "rm -* /System*": "deny",
      "rm -* /Library*": "deny",
      "rm -* /Applications*": "deny",
      "rm -* /private*": "deny",
      "sudo rm *": "deny",
      "* rm -* /": "deny",
      // Raw disk writes / formatting.
      "dd *of=/dev/*": "deny",
      "* dd *of=/dev/*": "deny",
      "mkfs*": "deny",
      // Irreversible permission / ownership changes at the root.
      "chmod -R 777 /*": "deny",
      "chown -R * /*": "deny",
      // Fork bomb, shell-history wipe, power control.
      "*:(){*": "deny",
      "history -c": "deny",
      "shutdown*": "deny",
      "sudo shutdown*": "deny",
      "reboot*": "deny",
      "sudo reboot*": "deny",
      // Git history / worktree destruction (safe escapes re-allowed below).
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -*f*": "deny",
      "git rm *": "deny",
      "git restore *": "deny",
      "git push --force-with-lease*": "allow",
      "git clean -*n*": "allow",
      "git rm *--cached*": "allow",
      "git restore --staged*": "allow",
    },
    "edit": {
      "*": "allow",
      "*.md": "allow",
    },
    "webfetch": "allow",
    "skill": {
      // Broad rule FIRST: opencode keeps the LAST matching rule, so the
      // specific denies below only take effect after this line.
      "*": "allow",
      "wecomcli-*": "deny",
      "microsoft-foundry": "deny",
      "deploy-model": "deny",
      "capacity": "deny",
      "customize": "deny",
      "weekly-report": "deny",
      "brainstorm-okrs": "deny",
      "uv-package-manager": "deny",
      "dash-doc-generation-config": "deny",
      "dotter-manager": "deny",
      "prompt-generator": "deny",
      "constitutional-ai": "deny",
      "agent-development": "deny",
      "ponytail-audit": "deny",
      "ponytail-debt": "deny",
      "ponytail-gain": "deny",
      "ponytail-help": "deny",
      "ponytail-review": "deny",
      "openspec-archive-change": "deny",
      "find-skills": "deny",
      "metaskill": "deny",
      "darwin-skill": "deny",
      "skill-creator": "deny",
    },
  },
  "provider": {
    "alibaba-cn": {
      "options": {
        "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      },
    },
    "wolf-ack": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wolf Ack",
      "options": {
        "baseURL": "http://10.147.254.3:8004/v1",
        "litellmProxy": true,
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash",
          "id": "svc/ack-dev",
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "limit": {
            "context": 524288,
            "output": 32768,
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
          },
        },
      },
    },
  },
  "lsp": {
    "marksman-lsp": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".mdc"
      ],
    },
  },
}