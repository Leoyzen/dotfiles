{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp",
    "oh-my-opencode-slim@latest",
    // "oh-my-openagent@latest",
    // "/Users/yuchen.liu/.config/herdr/plugins/github/gavintomlins.herdr-oh-my-agent-d4df23d2318b/packages/herdr-subagent-panes",
    // "superpowers@git+https://github.com/obra/superpowers.git",
    "@openviking/opencode-plugin",
  ],
  "autoupdate": true,
  "snapshot": false,
  "model": "wolf-ai/glm-5.3",
  "mcp": {
    "mcp-router": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mcp_router/cli@latest",
        "connect"
      ],
      "environment": {
        "MCPR_TOKEN": "{env:MCPR_TOKEN}",
      },
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
  },
  "enabled_providers": [
    "alibaba-cn",
    "wolf-ai",
    "wolf-ack",
    "deepseek",
    "openai"
  ],
  "tools": {
    "write": true,
    "bash": true,
    "read": true,
    "edit": true,
    "glob": true,
    "grep": true,
  },
  "agent": {
    "compaction": {
      "model": "wolf-ai/glm-5.3",
      "variant": "medium",
    },
    "build": {
      "mode": "primary",
      "model": "wolf-ai/glm-5.3-flash",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
      },
    },
    "plan": {
      "mode": "primary",
      "model": "wolf-ai/glm-5.3",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
      },
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "wolf-ai/glm-5.3",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false,
      },
    },
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git rm *": "ask",
      "git checkout *": "allow",
      "git restore *": "ask",
      "rm *": "allow",
    },
    "edit": {
      "*": "allow",
      "*.md": "allow",
    },
    "webfetch": "allow",
    "skill": {
      "wecomcli-*": "deny",
      "microsoft-foundry": "deny",
      "deploy-model": "deny",
      "capacity": "deny",
      "customize": "deny",
      "weekly-report": "deny",
      "brainstorm-okrs": "deny",
      "uv-package-manager": "deny",
      "dash-doc-generation-config": "deny",
      "dotter-manager": "deny",
      "prompt-generator": "deny",
      "constitutional-ai": "deny",
      "agent-development": "deny",
      "ponytail-audit": "deny",
      "ponytail-debt": "deny",
      "ponytail-gain": "deny",
      "ponytail-help": "deny",
      "ponytail-review": "deny",
      "openspec-archive-change": "deny",
      "find-skills": "deny",
      "metaskill": "deny",
      "darwin-skill": "deny",
      "skill-creator": "deny",
      "*": "allow",
    },
  },
  "provider": {
    "alibaba-cn": {
      "options": {
        "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
        "apiKey": "{env:ALIYUN_TOKEN_API_KEY}",
      },
    },
    "wolf-ack": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wolf Ack",
      "options": {
        "baseURL": "http://10.147.254.3:8004/v1",
        "litellmProxy": true,
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash",
          "id": "svc/ack-dev",
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "limit": {
            "context": 524288,
            "output": 32768,
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
          },
        },
      },
    },
    "wolf-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wolf AI",
      "options": {
        "baseURL": "http://api.ai.rootcloud.info/v1",
        "litellmProxy": true,
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash",
          "id": "svc/deepseek-v4-flash",
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "options": {
            "thinking": true
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "disabled": true
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            // "context": 202752,
            // "context": 1048576,
            "context": 524288,
            "output": 65535,
          },
          "modalities": {
            "input": [
              "text",
              // "image"
            ],
            "output": [
              "text"
            ],
          },
        },
        "qwen-3.8-flash": {
          "name": "Qwen 3.8 Flash",
          "id": "svc/qwen38-flash",
          "attachment": true,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "options": {
            "thinking": true
          },
          "limit": {
            // "context": 202752,
            // "context": 1048576,
            "context": 262144,
            "output": 65535,
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "id": "glm-5.3",
          "reasoning": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning_content",
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            // "context": 252144,
            // "context": 262144,
            // "context": 512000,
            "context": 1048576,
            // "context": 524288,
            // "context": 202752,
            "output": 131072,
          },
          "modalities": {
            "input": [
              "text",
              // "image",
              // "video"
            ],
            "output": [
              "text"
            ],
          },
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "id": "svc/glm-5.3-flash",
          "reasoning": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning_content",
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            // "context": 252144,
            // "context": 262144,
            // "context": 512000,
            "context": 1048576,
            // "context": 524288,
            // "context": 202752,
            "output": 131072,
          },
          "modalities": {
            "input": [
              "text",
              "image",
              // "video"
            ],
            "output": [
              "text"
            ],
          },
        },
        "glm-5.3-flash-dev": {
          "name": "GLM 5.3 Flash (Dev)",
          "id": "svc/ack-dev",
          "reasoning": true,
          "attachment": false,
          "interleaved": {
            "field": "reasoning_content",
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          },
          "limit": {
            "context": 1048576,
            "output": 131072,
          },
          "modalities": {
            "input": [
              "text",
              "image",
            ],
            "output": [
              "text"
            ],
          },
        },
        "qwen38": {
          "name": "Qwen 3.8",
          "id": "dashscope/qwen3.8-max",
          "reasoning": false,
          "attachment": false,
          "limit": {
            "context": 262144,
            "output": 32768,
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
          },
        },
      },
    },
  },
  "lsp": {
    "marksman-lsp": {
      "command": [
        "marksman",
        "server"
      ],
      "extensions": [
        ".md",
        ".mdc"
      ],
    },
  },
}