{
  "enabled": true,
  "mcp": { "enabled": true },

  "timeoutMs": 20000,

  "autoRecall": {
    "enabled": true,
    "limit": 5,
    "scoreThreshold": 0.4,
    "maxContentChars": 400,
    "preferAbstract": true,
    "tokenBudget": 1500,
    "minQueryLength": 3
  },

  "recallQueryExpansion": "off",
  "recallPeerScope": "all",

  "autoCapture": true,
  "captureMode": "semantic",
  "captureMaxLength": 24000,
  "captureAssistantTurns": true,
  "captureToolMaxChars": 50000,

  "commitTokenThreshold": 100000,
  "commitKeepRecentCount": 10,

  "profileTokenBudget": 5000,
  "resumeContextBudget": 16000,

  "repoContext": {
    "enabled": true,
    "cacheTtlMs": 120000
  }
}
