    "categories": {
      "visual-engineering": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "high",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "opencode/glm-5"
          },
          {
            "model": "opencode/claude-opus-4-7",
            "reasoning": "max"
          }
        ]
      },
      "ultrabrain": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "xhigh",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gpt-5.5",
            "reasoning": "xhigh"
          },
          {
            "model": "google/gemini-3.1-pro-preview",
            "reasoning": "high"
          },
          {
            "model": "opencode/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "opencode/claude-opus-4-7",
            "reasoning": "max"
          }
        ]
      },
      "deep": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "medium",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "opencode/claude-opus-4-7",
            "reasoning": "max"
          },
          {
            "model": "google/gemini-3.1-pro-preview",
            "reasoning": "high"
          },
          {
            "model": "opencode/gemini-3.1-pro",
            "reasoning": "high"
          }
        ]
      },
      "artistry": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "high",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gemini-3.1-pro",
            "reasoning": "high"
          },
          {
            "model": "opencode/claude-opus-4-7",
            "reasoning": "max"
          },
          {
            "model": "openai/gpt-5.5"
          },
          {
            "model": "opencode/gpt-5.5"
          }
        ]
      },
      "quick": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gpt-5.4-mini"
          },
          {
            "model": "google/gemini-3-flash-preview"
          },
          {
            "model": "opencode/gemini-3-flash"
          },
          {
            "model": "opencode/gpt-5-nano"
          }
        ]
      },
      "unspecified-low": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "openai/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "opencode/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "google/gemini-3-flash-preview"
          },
          {
            "model": "opencode/gemini-3-flash"
          }
        ]
      },
      "unspecified-high": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "openai/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "opencode/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "google/gemini-3-flash-preview"
          },
          {
            "model": "opencode/gemini-3-flash"
          }
        ]
      },
      "writing": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "models": [
          "alibaba-cn/deepseek-v4.1-flash",
          {
            "model": "opencode/gemini-3-flash"
          },
          {
            "model": "opencode/claude-sonnet-4-6"
          }
        ]
      }
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": true,
      "planner_enabled": false,
      "replace_plan": true
    },
    "background_task": {
      "defaultConcurrency": 10,
      "providerConcurrency": {
        "google": 3,
        "alibaba-cn": 20
      }
    },
    "disabled_hooks": [
      "comment-checker",
      "agent-usage-reminder",
      "keyword-detector",
      "preemptive-compaction",
      "auto-update-checker",
      "startup-toast",
      "model-fallback",
      "codegraph-bootstrap",
      "ast-grep-sg-provision"
    ],
    "disabled_agents": [],
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 60,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
