            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "atlas": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "reasoning": "medium"
          },
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "document-writer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "alibaba-cn/deepseek-v4.1-flash"
          }
        ],
