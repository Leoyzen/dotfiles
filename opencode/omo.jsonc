// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "team_mode": {
      "enabled": false,
      "max_parallel_members": 8,
      "tmux_visualization": true
    },
    "agents": {
      "sisyphus": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "max",
        "fallback_models": [
          {
            "model": "deepseek/deepseek-v4-pro",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "sisyphus-junior": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "default"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "general": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "alibaba-cn/deepseek-v4.1-flash"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "hephaestus": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "permission": {
          "edit": "allow"
        }
      },
      "oracle": {
        "model": "alibaba-cn/glm-5.3",
        "reasoning": "high",
        "fallback_models": [
          {
            "model": "deepseek/deepseek-v4-pro",
            "reasoning": "high"
          },
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "librarian": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "explore": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          },
          {
            "model": "openai/gpt-5.4-nano"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "multimodal-looker": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "medium",
        "fallback_models": [
          {
            "model": "openai/gpt-5-nano"
          },
          {
            "model": "opencode/gpt-5-nano"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "prometheus": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "max",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "reasoning": "high"
          },
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "metis": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "reasoning": "high"
          },
          {
            "model": "alibaba-cn/deepseek-v4.1-flash",
            "reasoning": "high"
          }
        ],
        "permission": {
          "edit": "allow"
        }
      },
      "momus": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "reasoning": "xhigh",
