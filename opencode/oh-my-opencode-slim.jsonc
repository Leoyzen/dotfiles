// oh-my-opencode-slim configuration
// Presets: cheap / balanced (default) / powerful / openai-only / hybrid-best
// Switch at runtime via /preset TUI command, or set "preset" field below.
{
  // Active preset (change via /preset or here)
  "preset": "balanced",
  // Root agent overrides — permission { "*": "allow" } applies to all tools
  "agents": {
    "orchestrator": {
      "permission": {
        "*": "allow"
      }
    },
    "oracle": {
      "permission": {
        "*": "allow"
      }
    },
    "explorer": {
      "permission": {
        "*": "allow"
      }
    },
    "librarian": {
      "permission": {
        "*": "allow"
      }
    },
    "fixer": {
      "permission": {
        "*": "allow"
      }
    },
    "designer": {
      "permission": {
        "*": "allow"
      }
    },
    "observer": {
      "permission": {
        "*": "allow"
      }
    },
    "council": {
      "permission": {
        "*": "allow"
      }
    },
  },
  "presets": {
    // ── cheap: all flash/nano, minimum cost ──
    "cheap": {
      "orchestrator": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "oracle": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ],
        "variant": "medium"
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "designer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
    },
    // ── balanced: key agents on glm-5.3, helpers on flash ──
    "balanced": {
      "orchestrator": {
        "variant": "high"
      },
      "oracle": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash", "variant": "max" },
          { "id": "wolf-ai/deepseek-v4-flash", "variant": "max" },
          { "id": "openai/gpt-5.6-luna" },
        ]
      },
      "designer": {
        "model": [
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
          { "id": "alibaba-cn/qwen3.8-max" },
          { "id": "wolf-ai/glm-5.3-flash" },
        ]
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
    },
    // ── powerful: all glm-5.3, reasoning cranked ──
    "powerful": {
      "orchestrator": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
      "oracle": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
      "explorer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "low"
      },
      "librarian": {
        "model": "wolf-ai/glm-5.3",
        "variant": "low"
      },
      "fixer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "designer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
    },
    // ── openai-only: all OpenAI provider ──
    "openai-only": {
      "orchestrator": {
        "model": "openai/gpt-5.5"
      },
      "oracle": {
        "model": "openai/gpt-5.5"
      },
      "explorer": {
        "model": "openai/gpt-5.4-nano"
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "openai/gpt-5.5"
      },
      "designer": {
        "model": "openai/gpt-5.5"
      },
      "observer": {
        "model": "openai/gpt-5.4-nano"
      },
      "council": {
        "model": "openai/gpt-5.5"
      },
    },
    // ── hybrid-best: best model per role across providers ──
    "hybrid-best": {
      "orchestrator": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
      "oracle": {
        "model": "openai/gpt-5.5"
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4-flash" },
        ]
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "designer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
    },
  },
  // Multiplexer — match existing tmux setup from omo config
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60,
  },
}
