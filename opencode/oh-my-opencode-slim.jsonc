// oh-my-opencode-slim configuration
// Presets: cheap / balanced (default) / powerful / openai-only / hybrid-best
// Switch at runtime via /preset TUI command, or set "preset" field below.
{
  // Active preset (change via /preset or here)
  "preset": "balanced",
  // Disable foreground model-fallback failover. With fallback enabled, a
  // subagent that triggers a model switch aborts its own session, which the
  // native `task` tool sees as "Task cancelled" and the result is lost.
  "fallback": {
    "enabled": false
  },
  // Root agent overrides — permission { "*": "allow" } applies to all tools
  "agents": {
    "orchestrator": {
      "permission": {
        // Root-scan guard: deny find/ls/du/tree/fd against the filesystem root.
        // Must come AFTER "*": "allow" — opencode evaluates the LAST matching rule.
        "bash": {
          "*": "allow",
          "find /": "deny",
          "find / *": "deny",
          "find  / *": "deny",
          "find -* / *": "deny",
          "sudo find / *": "deny",
          "nohup find / *": "deny",
          "time find / *": "deny",
          "nice find / *": "deny",
          "command find / *": "deny",
          "env * find / *": "deny",
          "*=* find / *": "deny",
          "*/find / *": "deny",
          "ls /": "deny",
          "ls / *": "deny",
          "ls -* / *": "deny",
          "du /": "deny",
          "du / *": "deny",
          "du -* / *": "deny",
          "tree /": "deny",
          "tree / *": "deny",
          "tree -* / *": "deny",
          "fd /": "deny",
          "fd / *": "deny",
          "fd -* / *": "deny",
        }
      }
    },
    "oracle": {
      "permission": {
        // Root-scan guard: deny find/ls/du/tree/fd against the filesystem root.
        // Must come AFTER "*": "allow" — opencode evaluates the LAST matching rule.
        "bash": {
