          "sudo find / *": "deny",
          "nohup find / *": "deny",
          "time find / *": "deny",
          "nice find / *": "deny",
          "command find / *": "deny",
          "env * find / *": "deny",
          "*=* find / *": "deny",
          "*/find / *": "deny",
          "ls /": "deny",
          "ls / *": "deny",
          "ls -* / *": "deny",
          "du /": "deny",
          "du / *": "deny",
          "du -* / *": "deny",
          "tree /": "deny",
