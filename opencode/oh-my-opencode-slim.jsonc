          "fd -* / *": "deny",
        }
      }
    },
    // custom agent: opencode-native code-reviewer, fallback chain via SLIM
    "code-reviewer": {
      "model": [
        { "id": "wolf-ai/glm-5.3" },
        { "id": "alibaba-cn/glm-5.2" },
        { "id": "wolf-ai/deepseek-v4.1-flash" },
      ]
    },
  },
  "presets": {
    // ── cheap: all flash/nano, minimum cost ──
    "cheap": {
      "orchestrator": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "oracle": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ],
        "variant": "medium"
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "designer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
    },
    // ── balanced: key agents on glm-5.3, helpers on flash ──
    "balanced": {
      "orchestrator": {
        "variant": "high"
      },
      "oracle": {
        "model": "alibaba-cn/glm-5.3"
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "wolf-ai/deepseek-v4.1-flash", "variant": "max" },
          { "id": "wolf-ai/glm-5.3-flash", "variant": "max" },
        ]
      },
      "designer": {
        "model": "wolf-ai/glm-5.3-flash"
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
    },
    // ── powerful: all glm-5.3, reasoning cranked ──
    "powerful": {
      "orchestrator": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
      "oracle": {
        "model": [
          { "id": "wolf-ai/glm-5.3", "variant": "max" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "low"
      },
      "librarian": {
        "model": "wolf-ai/glm-5.3",
        "variant": "low"
      },
      "fixer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "designer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
    },
    // ── openai-only: all OpenAI provider ──
    "openai-only": {
      "orchestrator": {
        "model": "openai/gpt-5.5"
      },
      "oracle": {
        "model": [
          { "id": "openai/gpt-5.5" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": "openai/gpt-5.4-nano"
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "openai/gpt-5.5"
      },
      "designer": {
        "model": "openai/gpt-5.5"
      },
      "observer": {
        "model": "openai/gpt-5.4-nano"
      },
      "council": {
        "model": "openai/gpt-5.5"
      },
    },
    // ── hybrid-best: best model per role across providers ──
    "hybrid-best": {
      "orchestrator": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
      "oracle": {
        "model": [
          { "id": "openai/gpt-5.5" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": [
          { "id": "wolf-ai/glm-5.3-flash" },
          { "id": "wolf-ai/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "designer": {
        "model": "wolf-ai/glm-5.3",
        "variant": "high"
      },
      "observer": {
        "model": "wolf-ai/qwen38"
      },
      "council": {
        "model": "wolf-ai/glm-5.3",
        "variant": "max"
      },
    },
  },
  // Multiplexer — match existing tmux setup from omo config
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60,
  },
}
