        "bash": {
          "*": "allow",
          "find /": "deny",
          "find / *": "deny",
          "find  / *": "deny",
          "find -* / *": "deny",
          "sudo find / *": "deny",
          "nohup find / *": "deny",
          "time find / *": "deny",
          "nice find / *": "deny",
          "command find / *": "deny",
          "env * find / *": "deny",
          "*=* find / *": "deny",
          "*/find / *": "deny",
          "ls /": "deny",
