// oh-my-opencode-slim configuration
// Presets: cheap / balanced (default) / powerful / openai-only / hybrid-best
// Switch at runtime via /preset TUI command, or set "preset" field below.
{
  // Active preset (change via /preset or here)
  // Profile presets: "bailian" (百炼 alibaba-cn) | "go" (OpenCode Go opencode-go)
  "preset": "go",
  // Disable foreground model-fallback failover. With fallback enabled, a
  // subagent that triggers a model switch aborts its own session, which the
  // native `task` tool sees as "Task cancelled" and the result is lost.
  "fallback": {
    "enabled": false
  },
  // Agent overrides.
  // NOTE: per-agent `permission` rules are appended AFTER the global
  // `permission` block in opencode.jsonc (opencode evaluates the LAST match),
  // so the previous per-agent `bash: { "*": "allow", ... }` blocks silently
  // overrode the global root-scan / high-risk denies for every SLIM agent.
  // Removed on purpose: all SLIM agents now inherit the global ruleset
  // (allow-by-default plus the deny guards). `council` stays unset so SLIM's
  // synthesis-only permission (no tools) is preserved.
  "agents": {
    // code-reviewer's model comes from the active profile preset (bailian | go).
    // A global `agents.<name>.model` override here would WIN over the preset and
    // stay on a dead provider after a profile switch, so none is set.
  },
  "presets": {
    // ══ Profiles: switch the whole stack's PROVIDER with /preset ══
    // `bailian` = 百炼 Token Plan (alibaba-cn); `go` = OpenCode Go (opencode-go).
    // Both providers expose the same model ids, so the two presets are the same
    // shape under a different prefix. They intentionally cover EVERY agent that
    // takes a model (native build/plan/compaction/summary/title included), so a
    // single /preset switch leaves nothing pointing at a dead provider.
    "bailian": {
      "orchestrator": { "model": "alibaba-cn/deepseek-v4.1-flash", "variant": "high" },
      "oracle": { "model": "alibaba-cn/glm-5.3" },
      "explorer": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "librarian": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "fixer": { "model": "alibaba-cn/deepseek-v4.1-flash", "variant": "max" },
      "designer": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "code-reviewer": { "model": [{ "id": "alibaba-cn/deepseek-v4.1-flash" }, { "id": "alibaba-cn/glm-5.3" }] },
      "build": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "plan": { "model": "alibaba-cn/deepseek-v4.1-flash", "variant": "high" },
      "compaction": { "model": "alibaba-cn/deepseek-v4.1-flash", "variant": "high" },
      "summary": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "title": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "explore": { "model": "alibaba-cn/deepseek-v4.1-flash" },
      "general": { "model": "alibaba-cn/deepseek-v4.1-flash" },
    },
    "go": {
      "orchestrator": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
      "oracle": { "model": "opencode-go/glm-5.3" },
      "explorer": { "model": "opencode-go/deepseek-v4.1-flash" },
      "librarian": { "model": "opencode-go/deepseek-v4.1-flash" },
      "fixer": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "max" },
      "designer": { "model": "opencode-go/deepseek-v4.1-flash" },
      "code-reviewer": { "model": [{ "id": "opencode-go/deepseek-v4.1-flash" }, { "id": "opencode-go/glm-5.3" }] },
      "build": { "model": "opencode-go/deepseek-v4.1-flash" },
      "plan": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
      "compaction": { "model": "opencode-go/deepseek-v4.1-flash", "variant": "high" },
      "summary": { "model": "opencode-go/deepseek-v4.1-flash" },
      "title": { "model": "opencode-go/deepseek-v4.1-flash" },
      "explore": { "model": "opencode-go/deepseek-v4.1-flash" },
      "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    },
    // ── cheap: all flash/nano, minimum cost ──
    "cheap": {
      "orchestrator": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "oracle": {
        "model": [
          { "id": "alibaba-cn/glm-5.3" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ],
        "variant": "medium"
      },
      "explorer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "designer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "observer": {
        "model": "alibaba-cn/deepseek-v4.1-flash"
      },
      "council": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
    },
    // ── balanced: key agents on glm-5.3, helpers on flash ──
    "balanced": {
      "orchestrator": {
        "variant": "high"
      },
      "oracle": {
        "model": "alibaba-cn/glm-5.3"
      },
      "explorer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "fixer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash", "variant": "max" },
        ]
      },
      "designer": {
        "model": "alibaba-cn/deepseek-v4.1-flash"
      },
      "observer": {
        "model": "alibaba-cn/deepseek-v4.1-flash"
      },
      "council": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "high"
      },
    },
    // ── powerful: all glm-5.3, reasoning cranked ──
    "powerful": {
      "orchestrator": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "max"
      },
      "oracle": {
        "model": [
          { "id": "alibaba-cn/glm-5.3", "variant": "max" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "low"
      },
      "librarian": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "low"
      },
      "fixer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "high"
      },
      "designer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "high"
      },
      "observer": {
        "model": "alibaba-cn/deepseek-v4.1-flash"
      },
      "council": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "max"
      },
    },
    // ── openai-only: all OpenAI provider ──
    "openai-only": {
      "orchestrator": {
        "model": "openai/gpt-5.5"
      },
      "oracle": {
        "model": [
          { "id": "openai/gpt-5.5" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": "openai/gpt-5.4-nano"
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "openai/gpt-5.5"
      },
      "designer": {
        "model": "openai/gpt-5.5"
      },
      "observer": {
        "model": "openai/gpt-5.4-nano"
      },
      "council": {
        "model": "openai/gpt-5.5"
      },
    },
    // ── hybrid-best: best model per role across providers ──
    "hybrid-best": {
      "orchestrator": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "max"
      },
      "oracle": {
        "model": [
          { "id": "openai/gpt-5.5" },
          { "id": "openai/gpt-5.6-luna", "variant": "high" },
        ]
      },
      "explorer": {
        "model": [
          { "id": "alibaba-cn/deepseek-v4.1-flash" },
        ]
      },
      "librarian": {
        "model": "openai/gpt-5.4-nano"
      },
      "fixer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "high"
      },
      "designer": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "high"
      },
      "observer": {
        "model": "alibaba-cn/deepseek-v4.1-flash"
      },
      "council": {
        "model": "alibaba-cn/deepseek-v4.1-flash",
        "variant": "max"
      },
    },
  },
  // Multiplexer — match existing tmux setup from omo config
  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 60,
    // OMO defaults to the lightweight `opencode mini` viewer on OpenCode v2
    // (v1 defaulted to the full TUI). Force the full interface in subagent panes.
    "viewer": "tui",
  },
}
